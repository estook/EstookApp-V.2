# dependencias
node_modules/
.pnpm-store/

# construccion
dist/
build/
.turbo/
*.tsbuildinfo

# entorno · nunca se sube ninguna clave
.env
.env.*
!.env.example

# herramientas
coverage/
playwright-report/
test-results/
.eslintcache

# El cuaderno que la API de pruebas escribe mientras corren las de extremo a
# extremo. Lo lee `pnpm cobertura` justo despues, y no significa nada fuera de
# esa ejecucion.
pruebas/.cobertura-del-catalogo.json
dependencias.svg

# sistema
.DS_Store
Thumbs.db
*.log

# El HTML de repaso de los documentos maestros (`pnpm maestros --html`). Los PDF
# si se versionan: son el documento que se lee y se comparte.
docs/maestros/pdf/*.html

# Las capturas de la entrega V. Se versionan **solo las de Linux**, que son las que
# compara la integración continua; las de otro sistema se hacen para mirarlas
# (`CON_CAPTURAS=1`) y no coinciden con nada. Y `capturas-nuevas/` es donde una
# prueba deja la captura que no ha coincidido, para traerla o tirarla.
pruebas/e2e/capturas/win32/
pruebas/e2e/capturas/darwin/
pruebas/e2e/capturas-nuevas/
