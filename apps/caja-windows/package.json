{
  "name": "@estook/caja-windows",
  "version": "1.0.0",
  "private": true,
  "description": "La caja para Windows: Estook TPV en un programa, que imprime, abre el cajón y será el centro del local sin internet (0119)",
  "main": "dist/principal.cjs",
  "scripts": {
    "construir": "node construir.mjs",
    "preparar": "node node_modules/electron/install.js",
    "arrancar": "node construir.mjs && node node_modules/electron/install.js && electron .",
    "empaquetar": "node construir.mjs && electron-builder --win --publish never",
    "publicar": "node construir.mjs && electron-builder --win --publish always",
    "tipos": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@estook/cliente-api": "workspace:*",
    "@estook/dominio": "workspace:*",
    "@estook/impresion": "workspace:*",
    "@types/node": "^22.10.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.25.12",
    "typescript": "^5.7.2"
  }
}
